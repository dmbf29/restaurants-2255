<div class="container">
  <h1>Edit a Restaurant</h1>
  <!-- <form action="/restaurants/id" method="patch"> -->
  <%= simple_form_for @restaurant do |f| %>
    <%= f.input :name %>
    <%= f.input :address %>
    <%= f.input :rating %>
    <%= f.submit class: 'btn btn-primary mt-3' %>
  <% end %>
</div>
